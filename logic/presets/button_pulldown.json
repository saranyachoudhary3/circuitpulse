{"schema_version":1,"id":"button_pulldown","name":"Button with External Pull-Down","description":"A button drives a stable Arduino input with a pull-down resistor.","required_components":["arduino_uno","breadboard","button","resistor"],"connections":[{"id":"button_supply","from":"arduino:5V","to":"button:1","wire_color":"red","purpose":"Provides the pressed-state voltage."},{"id":"input","from":"button:2","to":"arduino:D2","wire_color":"yellow","purpose":"Carries the button state to the input."},{"id":"pull_down","from":"button:2","to":"resistor:1","purpose":"Anchors the input low when unpressed."},{"id":"ground","from":"resistor:2","to":"arduino:GND","wire_color":"black","purpose":"Completes the pull-down path."}],"build_order":[{"id":"button_supply"},{"id":"input"},{"id":"pull_down"},{"id":"ground"}]}
