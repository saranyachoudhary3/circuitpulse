{"schema_version":1,"id":"i2c_sensor","name":"I2C Sensor Module","description":"Arduino communicates with a fiducial-identified I2C sensor over SDA and SCL.","required_components":["arduino_uno","i2c_sensor"],"connections":[{"id":"power","from":"arduino:3V3","to":"sensor:VCC","wire_color":"red","purpose":"Powers the reviewed sensor at a safe voltage."},{"id":"ground","from":"sensor:GND","to":"arduino:GND","wire_color":"black","purpose":"Provides the common reference."},{"id":"sda","from":"arduino:SDA","to":"sensor:SDA","wire_color":"blue","purpose":"Connects the I2C data line."},{"id":"scl","from":"arduino:SCL","to":"sensor:SCL","wire_color":"yellow","purpose":"Connects the I2C clock line."}],"build_order":[{"id":"power"},{"id":"ground"},{"id":"sda"},{"id":"scl"}]}
